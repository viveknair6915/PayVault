# PayVault Root Environment Configuration Template
# (Copy this to backend/.env or configure in your deployment dashboard)

PORT=5000
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_key_here
PAYMENT_ENCRYPTION_KEY=generate_a_64_character_hex_key_here
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_oauth_android_client_id
CLIENT_URL=http://localhost:5173
NODE_ENV=development
